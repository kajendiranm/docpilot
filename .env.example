# Copy to .env and fill in. Never commit .env.

# Gemini (free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSIONS=768

# Postgres (docker compose maps the container to host port 5433)
DATABASE_URL=postgresql://docpilot:docpilot@localhost:5433/docpilot
READONLY_DATABASE_URL=postgresql://docpilot_reader:reader@localhost:5433/docpilot

# Retrieval
SEARCH_SCORE_THRESHOLD=0.3

# GitHub issues (fine-grained token scoped to GITHUB_REPO only, Issues: read & write)
GITHUB_TOKEN=
GITHUB_REPO=kajendiranm/docpilot-demo-docs
DRY_RUN=true

# Agent
MAX_TOOL_ITERATIONS=5
